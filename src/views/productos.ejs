<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard Admin - Productos </title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        max-width: 1600px;
        margin: 0 auto;
        padding: 20px;
        background-color: #f5f5f5;
      }

      h1 {
        color: #333;
        margin-bottom: 30px;
        font-size: 2rem;
      }

      .header-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
      }

      .btn-crear {
        padding: 12px 24px;
        background-color: #4caf50;
        color: white;
        text-decoration: none;
        border-radius: 6px;
        font-weight: 600;
        transition: all 0.2s;
      }

      .btn-crear:hover {
        background-color: #45a049;
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        overflow: hidden;
      }

      th,
      td {
        padding: 14px;
        text-align: left;
        color: #333;
      }

      th {
        background-color: #4caf50;
        color: white;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
      }

      tbody tr {
        border-bottom: 1px solid #e0e0e0;
        transition: background-color 0.2s;
      }

      tbody tr:hover {
        background-color: #f9f9f9;
      }

      tbody tr:last-child {
        border-bottom: none;
      }

      .producto-img {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 6px;
        border: 2px solid #e0e0e0;
      }

      .producto-info {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .producto-titulo {
        font-weight: 600;
        color: #333;
      }

      .producto-sku {
        font-size: 0.85rem;
        color: #666;
      }

      .badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
      }

      .badge-activo {
        background-color: #e8f5e9;
        color: #2e7d32;
      }

      .badge-inactivo {
        background-color: #ffebee;
        color: #c62828;
      }

      .stock-bajo {
        color: #f44336;
        font-weight: 600;
      }

      .stock-ok {
        color: #4caf50;
        font-weight: 600;
      }

      .acciones {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
      }

      .btn {
        padding: 6px 12px;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s;
        text-decoration: none;
        display: inline-block;
        color: white;
      }

      .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 3px 6px rgba(0, 0, 0, 0.2);
      }

      .btn-editar {
        background-color: #2196f3;
      }

      .btn-editar:hover {
        background-color: #1976d2;
      }

      .btn-desactivar {
        background-color: #ff9800;
      }

      .btn-desactivar:hover {
        background-color: #f57c00;
      }

      .btn-activar {
        background-color: #4caf50;
      }

      .btn-activar:hover {
        background-color: #388e3c;
      }

      .btn-eliminar {
        background-color: #f44336;
      }

      .btn-eliminar:hover {
        background-color: #d32f2f;
      }

      .resumen {
        margin-top: 30px;
        padding: 20px;
        background-color: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
      }

      .resumen-item {
        text-align: center;
      }

      .resumen-valor {
        font-size: 2rem;
        font-weight: 700;
        color: #4caf50;
      }

      .resumen-label {
        font-size: 0.9rem;
        color: #666;
        margin-top: 5px;
      }

      .no-productos {
        text-align: center;
        padding: 60px 20px;
        background-color: white;
        border-radius: 8px;
        color: #666;
        font-size: 1.2rem;
      }

      @media (max-width: 768px) {
        table {
          font-size: 0.8rem;
        }

        th,
        td {
          padding: 8px;
        }

        .producto-img {
          width: 40px;
          height: 40px;
        }

        .acciones {
          flex-direction: column;
        }

        .btn {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <div class="header-actions">
      <h1>Gestión de Productos</h1>
      <a href="/admin/productos/crear" class="btn-crear">➕ Nuevo Producto</a>
    </div>

    <% if (productos.length === 0) { %>
    <div class="no-productos">
      <p>No hay productos registrados</p>
    </div>
    <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Producto</th>
          <th>Precio</th>
          <th>Stock</th>
          <th>Tipo</th>
          <th>Estado</th>
          <th>Fecha Creación</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% productos.forEach(producto => { %>
        <tr>
          <td>
            <div class="producto-info">
              <img
                src="<%= producto.url_image || 'https://via.placeholder.com/60' %>"
                alt="<%= producto.titulo %>"
                class="producto-img"
              />
              <div>
                <div class="producto-titulo"><%= producto.titulo %></div>
                <div class="producto-sku">SKU: <%= producto.sku %></div>
              </div>
            </div>
          </td>
          <td><strong>$<%= Number(producto.precio).toFixed(2) %></strong></td>
          <td>
            <span class="<%= producto.stock < 10 ? 'stock-bajo' : 'stock-ok' %>">
              <%= producto.stock %> unidades
            </span>
          </td>
          <td><%= producto.id_tipo === 1 ? 'Remeras' : 'Buzos' %></td>
          <td>
            <% if (producto.activo) { %>
            <span class="badge badge-activo">Activo</span>
            <% } else { %>
            <span class="badge badge-inactivo">Inactivo</span>
            <% } %>
          </td>
          <td><%= new Date(producto.created_at).toLocaleDateString('es-AR') %></td>
          <td>
            <div class="acciones">
              <a href="/admin/productos/<%= producto.id %>/editar" class="btn btn-editar">
                Editar
              </a>
              <% if (producto.activo) { %>
              <button
                class="btn btn-desactivar"
                data-producto-id="<%= producto.id %>"
                data-action="desactivar"
              >
                Desactivar
              </button>
              <% } else { %>
              <button
                class="btn btn-activar"
                data-producto-id="<%= producto.id %>"
                data-action="activar"
              >
                Activar
              </button>
              <% } %>
            </div>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>

    <div class="resumen">
      <div class="resumen-item">
        <div class="resumen-valor"><%= productos.length %></div>
        <div class="resumen-label">Total Productos</div>
      </div>
      <div class="resumen-item">
        <div class="resumen-valor"><%= productos.filter(p => p.activo).length %></div>
        <div class="resumen-label">Activos</div>
      </div>
      <div class="resumen-item">
        <div class="resumen-valor"><%= productos.reduce((sum, p) => sum + p.stock, 0) %></div>
        <div class="resumen-label">Stock Total</div>
      </div>
      <div class="resumen-item">
        <div class="resumen-valor">
          $<%= productos.reduce((sum, p) => sum + (Number(p.precio) * p.stock), 0).toFixed(2) %>
        </div>
        <div class="resumen-label">Valor Inventario</div>
      </div>
    </div>
    <% } %>

    <script>
      // Agregar event listeners a todos los botones de acción
      document.querySelectorAll(".acciones button").forEach((btn) => {
        btn.addEventListener("click", function () {
          const id = this.getAttribute("data-producto-id");
          const action = this.getAttribute("data-action");

          if (action === "eliminar") {
            confirmarEliminacion(id);
          } else if (action === "desactivar") {
            cambiarEstado(id, false);
          } else if (action === "activar") {
            cambiarEstado(id, true);
          }
        });
      });

      function confirmarEliminacion(id) {
        if (
          confirm(
            `¿Estás seguro de eliminar el producto #${id}?\n\nEsta acción NO se puede deshacer.`
          )
        ) {
          fetch(`/admin/productos/${id}`, {
            method: "DELETE",
            headers: {
              "Content-Type": "application/json",
            },
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.status === 200) {
                alert("Producto eliminado exitosamente");
                window.location.reload();
              } else {
                alert("Error al eliminar el producto: " + data.message);
              }
            })
            .catch((error) => {
              console.error("Error:", error);
              alert("Error al eliminar el producto");
            });
        }
      }

      function cambiarEstado(id, activo) {
        const accion = activo ? "activar" : "desactivar";
        const mensaje = activo
          ? `¿Activar el producto #${id}?`
          : `¿Desactivar el producto #${id}?\n\nLos clientes no podrán verlo ni comprarlo.`;

        if (confirm(mensaje)) {
          fetch(`/admin/productos/${id}/estado`, {
            method: "PATCH",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify({ activo }),
          })
            .then((response) => response.json())
            .then((data) => {
              if (data.status === 200) {
                alert(`Producto ${accion === "activar" ? "activado" : "desactivado"} exitosamente`);
                window.location.reload();
              } else {
                alert(`Error al ${accion} el producto: ` + data.message);
              }
            })
            .catch((error) => {
              console.error("Error:", error);
              alert(`Error al ${accion} el producto`);
            });
        }
      }
    </script>
  </body>
</html>
